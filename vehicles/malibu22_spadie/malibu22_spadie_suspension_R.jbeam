"malibu22_spadie_strut_R_race": {
    "information":{
        "authors":"BeamNG",
        "name":"Race Rear Coilovers",
        "value":750,
    },
    "slotType" : "malibu22_spadie_strut_R",
    "flexbodies": [
         ["mesh", "[group]:", "nonFlexMaterials"],
         ["malibu22_spadie_strut_RR", ["malibu22_spadie_hub_R","malibu22_spadie_shocktop_R"]],
         ["malibu22_spadie_strut_RL", ["malibu22_spadie_hub_R","malibu22_spadie_shocktop_R"]],
    ],
    "variables": [
        ["name", "type", "unit", "category", "default", "min", "max", "title", "description"],
        ["$springheight_R", "range", "+m", "Suspension", 0, -0.06, 0.04, "Spring Height", "Raise or lower the suspension height", {"stepDis":0.005, "subCategory":"Rear"}],
        ["$spring_R", "range", "N/m", "Suspension", 55000, 15000, 120000, "Spring Rate", "Spring stiffness", {"stepDis":500, "subCategory":"Rear"}]
        ["$damp_bump_R", "range", "N/m/s", "Suspension", 5000, 500, 10000, "Bump Damping", "Damper rate in compression", {"stepDis":100, "subCategory":"Rear"}]
        ["$damp_rebound_R", "range", "N/m/s", "Suspension", 10000, 500, 20000, "Rebound Damping", "Damper rate in extension", {"stepDis":100, "subCategory":"Rear"}]
    ],
    "beams": [
          ["id1:", "id2:"],
          //rear springs and shocks without soft initial bump stop
          {"deformLimitExpansion":""},
          {"beamType":"|NORMAL"},
          {"beamDeform":15000,"beamStrength":150000},
          {"beamSpring":"$spring_R","beamDamp":0},
          //{"beamSpring":0,"beamDamp":0},
          //IMPORTANT: if precompressionRange is ~= nil then it supersedes beamPrecompression.
          //The case() is for backwards compatibility for old configs containing the "rideheight_R" variable.
          //To change the base ride height, edit the springheight_R offset in the expression.
          ["rh5l","r1ll", {"beamPrecompression":"$=$rideheight_R","precompressionRange":"$=case($rideheight_R == nil, $springheight_R + 0.02, '')",
              "soundFile":"event:>Vehicle>Suspension>car_modn_med_01>spring_compress_01","colorFactor":0.3,"attackFactor":25,"volumeFactor":1.60,"decayFactor":15,"noiseFactor":0.01,"pitchFactor":1.0,"maxStress":1400}],
          ["rh5r","r1rr", {"beamPrecompression":"$=$rideheight_R","precompressionRange":"$=case($rideheight_R == nil, $springheight_R + 0.02, '')",
              "soundFile":"event:>Vehicle>Suspension>car_modn_med_01>spring_compress_01","colorFactor":0.3,"attackFactor":25,"volumeFactor":1.60,"decayFactor":15,"noiseFactor":0.01,"pitchFactor":1.0,"maxStress":1400}],
          //shocks
          {"beamPrecompression":1, "beamType":"|BOUNDED", "beamLongBound":1.0, "beamShortBound":1.0},
          {"beamSpring":0,"beamDamp":"$damp_bump_R"},
          {"beamLimitSpring":0,"beamLimitDamp":0},
          ["rh5l","r1ll", {"beamDampRebound":"$damp_rebound_R","beamDampVelocitySplit":0.2,"beamDampFast":"$=$damp_bump_R/3","beamDampReboundFast":"$=$damp_rebound_R/3","dampCutoffHz":500}],
          ["rh5r","r1rr", {"beamDampRebound":"$damp_rebound_R","beamDampVelocitySplit":0.2,"beamDampFast":"$=$damp_bump_R/3","beamDampReboundFast":"$=$damp_rebound_R/3","dampCutoffHz":500}],
          //bump stop
          {"beamPrecompression":1, "beamType":"|BOUNDED"},
          {"beamSpring":0,"beamDamp":0},
          {"beamLimitSpring":251000,"beamLimitDamp":5000},
          ["rh5r","r1rr", {"longBoundRange":0.04,"shortBoundRange":0.09,"boundZone":0.025,"beamLimitDampRebound":0,"dampCutoffHz":500}],
          ["rh5l","r1ll", {"longBoundRange":0.04,"shortBoundRange":0.09,"boundZone":0.025,"beamLimitDampRebound":0,"dampCutoffHz":500}],
          {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
          {"deformLimitExpansion":1.1},
    ],
},
"malibu22_spadie_strut_R_rally": {
    "information":{
        "authors":"BeamNG",
        "name":"Rally Rear Coilovers",
        "value":750,
    },
    "slotType" : "malibu22_spadie_strut_R",
    "flexbodies": [
         ["mesh", "[group]:", "nonFlexMaterials"],
         ["malibu22_spadie_strut_RR", ["malibu22_spadie_hub_R","malibu22_spadie_shocktop_R"]],
         ["malibu22_spadie_strut_RL", ["malibu22_spadie_hub_R","malibu22_spadie_shocktop_R"]],
    ],
    "variables": [
        ["name", "type", "unit", "category", "default", "min", "max", "title", "description"],
        ["$springheight_R_rally", "range", "+m", "Suspension", 0, -0.04, 0.06, "Spring Height", "Raise or lower the suspension height", {"stepDis":0.005, "subCategory":"Rear"}],
        ["$spring_R_rally", "range", "N/m", "Suspension", 22000, 7000, 57000, "Spring Rate", "Spring stiffness", {"stepDis":500, "subCategory":"Rear"}]
        ["$damp_bump_R_rally", "range", "N/m/s", "Suspension", 3000, 500, 10000, "Bump Damping", "Damper rate in slow compression", {"stepDis":100, "subCategory":"Rear"}]
        ["$damp_bump_R_fast_rally", "range", "N/m/s", "Suspension", 2000, 500, 10000, "Fast Bump Damping", "Damper rate in fast compression", {"stepDis":100, "subCategory":"Rear"}]
        ["$damp_rebound_R_rally", "range", "N/m/s", "Suspension", 3900, 500, 10000, "Rebound Damping", "Damper rate in extension", {"stepDis":100,"subCategory":"Rear"}]
        ["$damp_rebound_R_fast_rally", "range", "N/m/s", "Suspension", 1900, 500, 10000, "Fast Rebound Damping", "Damper rate in fast extension", {"stepDis":100,"subCategory":"Rear"}]
    ],
    "beams": [
          ["id1:", "id2:"],
          //rear springs
          {"beamType":"|NORMAL"},
          {"beamDeform":30000,"beamStrength":200000},
          {"beamSpring":"$spring_R_rally","beamDamp":0},
          ["rh5r","r1rr", {"precompressionRange":"$=$springheight_R_rally + 0.105","soundFile":"event:>Vehicle>Suspension>car_modn_med_01>spring_compress_01","colorFactor":0.4,"attackFactor":36,"volumeFactor":1.15,"decayFactor":6,"noiseFactor":0.01,"pitchFactor":0.7,"maxStress":3600}],
          ["rh5l","r1ll", {"precompressionRange":"$=$springheight_R_rally + 0.105","soundFile":"event:>Vehicle>Suspension>car_modn_med_01>spring_compress_01","colorFactor":0.4,"attackFactor":36,"volumeFactor":1.15,"decayFactor":6,"noiseFactor":0.01,"pitchFactor":0.7,"maxStress":3600}],
          {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
          //dampers
          {"beamPrecompression":1, "beamType":"|BOUNDED", "beamLongBound":1, "beamShortBound":1},
          {"beamSpring":0,"beamDamp":"$damp_bump_R_rally"},
          {"beamLimitSpring":0,"beamLimitDamp":0},
          //bump
          ["rh5r","r5rr", {"name":"shock_RR", "beamDampRebound":0,"beamDampVelocitySplit":0.35,"beamDampFast":"$damp_bump_R_fast_rally","beamDampReboundFast":0,"dampCutoffHz":500}],
          ["rh5l","r5ll", {"name":"shock_RL", "beamDampRebound":0,"beamDampVelocitySplit":0.35,"beamDampFast":"$damp_bump_R_fast_rally","beamDampReboundFast":0,"dampCutoffHz":500}],
          //rebound
          {"beamSpring":0,"beamDamp":0},
          ["rh5r","r5rr", {"beamDampRebound":"$damp_rebound_R_rally","beamDampVelocitySplit":0.25,"beamDampFast":0,"beamDampReboundFast":"$damp_rebound_R_fast_rally","dampCutoffHz":500}],
          ["rh5l","r5ll", {"beamDampRebound":"$damp_rebound_R_rally","beamDampVelocitySplit":0.25,"beamDampFast":0,"beamDampReboundFast":"$damp_rebound_R_fast_rally","dampCutoffHz":500}],
          //hydraulic bump stop
          {"beamSpring":0,"beamDamp":0},
          {"beamLimitSpring":8000,"beamLimitDamp":9000},
          ["rh5r","r5rr", {"longBoundRange":2,"shortBoundRange":0.044,"boundZone":0.01,"beamLimitDampRebound":1000,"dampCutoffHz":250}],
          ["rh5l","r5ll", {"longBoundRange":2,"shortBoundRange":0.044,"boundZone":0.01,"beamLimitDampRebound":1000,"dampCutoffHz":250}],
          {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
    ],
},
