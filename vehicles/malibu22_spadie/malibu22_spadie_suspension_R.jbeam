          ["arbr1l", "f4l"],
          ["arbr1l", "f9l"],
          ["arbr1l", "f9r"],
          ["arbr1l", "f4r"],
          {"deformLimitExpansion":1.1},

          ["arbr1l", "arbr1r"],

          //end links
