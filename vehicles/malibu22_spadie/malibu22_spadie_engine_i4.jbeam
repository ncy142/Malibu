{
"malibu22_spadie_engine_dohc": {
    "information":{
        "authors":"BeamNG",
        "name":"2.0L I4 Engine",
        "value":3400,
    },
    "slotType" : "malibu22_spadie_engine",
    "slots": [
        ["type", "default", "description"],
        ["malibu22_spadie_enginemounts","malibu22_spadie_enginemounts", "Engine Mounts", {"coreSlot":true}],
        ["malibu22_spadie_intake_i4_2.0","malibu22_spadie_intake_i4_2.0", "Intake", {"coreSlot":true}],
        ["malibu22_spadie_oilpan_i4","malibu22_spadie_oilpan_i4", "Oil Pan", {"coreSlot":true}],
        ["malibu22_spadie_engine_i4_ecu","malibu22_spadie_engine_i4_ecu", "Engine Management", {"coreSlot":true}],
        ["n2o_system","", "Nitrous Oxide System"],
        ["malibu22_spadie_engine_i4_internals","malibu22_spadie_engine_i4_internals", "Engine Long Block", {"coreSlot":true}],
        ["malibu22_spadie_transmission","malibu22_spadie_transmission_4A", "Transmission"],
    ],
    "powertrain": [
        ["type", "name", "inputName", "inputIndex"],
        ["combustionEngine", "mainEngine", "dummy", 0],
    ],
    "mainEngine":{
        "torque":[
            ["rpm", "torque"],
            [0, 0],
            [500, 126],
            [1000, 136],
            [2000, 163],
            [3000, 177],
            [4000, 246],
            [4500, 250],
            [5000, 251],
            [5500, 241],
            [6000, 230],
            [7000, 200],
            [7500, 157],
            [8000, 120],
            [9000, 10],
        ],

        "idleRPM":900,
        //max capable
        "maxRPM":6600,
        "inertia":0.09,
        "friction":13,
        "dynamicFriction":0.02,
        "engineBrakeTorque":34,
        //"burnEfficiency":0.36
        "burnEfficiency":[
            [0, 0.10],
            [0.05, 0.24],
            [0.4, 0.39],
            [0.7, 0.46],
            [1, 0.34],
        ],
        //fuel system
        "energyStorage": ["mainTank", "auxTank"],
        "requiredEnergyType":"gasoline",

        //exhaust
        "instantAfterFireSound": "event:>Vehicle>Afterfire>i4_01>single",
        "sustainedAfterFireSound": "event:>Vehicle>Afterfire>i4_01>multi",
        "shiftAfterFireSound": "event:>Vehicle>Afterfire>i4_01>shift",
        "particulates":0.025,
        "instantAfterFireCoef": 0.75,
        "sustainedAfterFireCoef": 0.75,
        "instantAfterFireVolumeCoef": 0.8,
        "sustainedAfterFireVolumeCoef": 0.5,
        "shiftAfterFireVolumeCoef": 0.7,

        //cooling and oil system
        "thermalsEnabled":true,
        "engineBlockMaterial":"aluminum",
        "oilVolume":4,
        "engineBlockAirCoolingEfficiency":26,

        //engine durability
        "cylinderWallTemperatureDamageThreshold":160,
        "headGasketDamageThreshold":1800000,
        "pistonRingDamageThreshold":1800000,
        "connectingRodDamageThreshold":2000000,
        "maxTorqueRating": 310,
        "maxOverTorqueDamage": 550,

        //node beam interface
        "torqueReactionNodes:":["e1l","e2l","e4r"],
        "waterDamage": {"[engineGroup]:":["engine_intake"]},
        "radiator": {"[engineGroup]:":["radiator"]},
        "engineBlock": {"[engineGroup]:":["engine_block"]},
        "breakTriggerBeam":"engine",
        "uiName":"Engine",
        "soundConfig": "soundConfig",
        "soundConfigExhaust": "soundConfigExhaust",

        //starter motor
        "starterSample":"event:>Engine>Starter>i4_1996_eng",
        "starterSampleExhaust":"event:>Engine>Starter>i4_1996_exh",
        "shutOffSampleEngine":"event:>Engine>Shutoff>i4_1996_eng",
        "shutOffSampleExhaust":"event:>Engine>Shutoff>i4_1996_exh",
        "starterVolume":0.76,
        "starterVolumeExhaust":0.76,
        "shutOffVolumeEngine":0.76,
        "shutOffVolumeExhaust":0.76,
        "starterThrottleKillTime":0.65,
        "idleRPMStartRate":2,
        "idleRPMStartCoef":1,

        //engine deform groups
        "deformGroups":["mainEngine", "mainEngine_intake", "mainEngine_accessories"]
        "deformGroups_oilPan":["oilpan_damage"]
    },
    "soundConfig": {
