"malibu22_spadie_brake_F_race": {
    "information":{
        "authors":"BeamNG",
        "name":"Race Front Disc Brakes",
        "value":700,
    },
    "slotType" : "malibu22_spadie_brake_F",
    "slots": [
        ["type", "default", "description"],
        ["brakepad_F","brakepad_F_race", "Front Brake Pads", {"coreSlot":true}],
    ],
    "flexbodies": [
        ["mesh", "[group]:", "nonFlexMaterials"],
        ["brake_disc_slotted",             ["wheel_FR","wheelhub_FR"],      [], {"pos":{"x":-0.775, "y":-1.34, "z":0.33}, "scale":{"x":1.1, "y":0.95, "z":0.95}, "rot":{"x":0,   "y":0,   "z":0  }}],
        ["brake_disc_slotted",             ["wheel_FL","wheelhub_FL"],      [], {"pos":{"x": 0.775, "y":-1.34, "z":0.33}, "scale":{"x":1.1, "y":0.95, "z":0.95}, "rot":{"x":180, "y":0,   "z":0  }}],
        ["brake_caliper_6pot_red_rotopad", ["malibu22_spadie_hub_F","wheelhub_FR"], [], {"pos":{"x":-0.775, "y":-1.34, "z":0.33}, "scale":{"x":1.2, "y":0.95, "z":0.95}, "rot":{"x":0    "y":0,   "z":0  }}],
        ["brake_caliper_6pot_red_rotopad", ["malibu22_spadie_hub_F","wheelhub_FL"], [], {"pos":{"x": 0.775, "y":-1.34, "z":0.33}, "scale":{"x":1.2, "y":0.95, "z":0.95}, "rot":{"x":0,   "y":180, "z":0  }}],
    ],
    "variables": [
        ["name", "type", "unit", "category", "default", "min", "max", "title", "description"],
        //["$braketorque_F", "range", "", "Brakes", 2400, 0, 4000, "Front Brake Torque", "Strength of the front brakes", {"minDis":0}]
        //["$braketorque", "range", "", "Brakes", 3600, 1000, 5000, "Max Brake Torque", "Scales the overall brake torque", {"minDis":0}]
        ["$brakebias", "range", "", "Brakes", 0.67, 0, 1, "Front/Rear Bias", "Percent of brake torque to the front wheels", {"minDis":0, "maxDis":100}],
    ],
    "pressureWheels": [
        ["name","hubGroup","group","node1:","node2:","nodeS","nodeArm:","wheelDir"],
        //brakes
        {"brakeTorque":"$=$brakestrength*3600*$brakebias"},
        {"brakeInputSplit":1},
        {"brakeSplitCoef":1},
        {"parkingTorque":0},
        {"brakeSpring":125},

        //brake thermals
        {"enableBrakeThermals":true},
        {"brakeDiameter":0.31},
        {"brakeMass":7.5},
        {"brakeType":"vented-disc"},
        {"rotorMaterial":"steel"},
        {"brakeVentingCoef":1.4},
        //brake sounds
        {"squealCoefNatural": 1.0, "squealCoefLowSpeed": 1.0}
    ],
},
