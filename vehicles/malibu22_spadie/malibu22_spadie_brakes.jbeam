{
"malibu22_spadie_brake_F": {
    "information":{
        "authors":"BeamNG",
        "name":"Front Disc Brakes",
        "value":250,
    },
    "slotType" : "malibu22_spadie_brake_F",
    "slots": [
        ["type", "default", "description"],
        ["brakepad_F","brakepad_F", "Front Brake Pads", {"coreSlot":true}],
    ],
    "flexbodies": [
        ["mesh", "[group]:", "nonFlexMaterials"],
        ["brake_disc_solid", ["wheel_FR","wheelhub_FR"], [],                  {"pos":{"x":-0.77, "y":-1.34, "z":0.33}, "scale":{"x":0.95, "y":0.95, "z":0.95}, "rot":{"x": 0,    "y":180, "z":0   }}],
        ["brake_disc_solid", ["wheel_FL","wheelhub_FL"], [],                  {"pos":{"x": 0.77, "y":-1.34, "z":0.33}, "scale":{"x":0.95, "y":0.95, "z":0.95}, "rot":{"x": 180,  "y":180, "z":0   }}],
        ["brake_caliper_standard_plain", ["malibu22_spadie_hub_F","wheelhub_FR"], [], {"pos":{"x":-0.77, "y":-1.335, "z":0.33}, "scale":{"x":0.95, "y":0.88, "z":0.88}, "rot":{"x": 8,    "y":0,   "z":0   }}],
        ["brake_caliper_standard_plain", ["malibu22_spadie_hub_F","wheelhub_FL"], [], {"pos":{"x": 0.77, "y":-1.335, "z":0.33}, "scale":{"x":0.95, "y":0.88, "z":0.88}, "rot":{"x":-8,    "y":180, "z":0   }}],
    ],
    "pressureWheels": [
        ["name","hubGroup","group","node1:","node2:","nodeS","nodeArm:","wheelDir"],
        //brakes
        {"brakeTorque":"$=$brakestrength*2650"},
        {"brakeInputSplit":1},
        {"brakeSplitCoef":1},
        {"parkingTorque":0},
        {"brakeSpring":125},

        //brake thermals
        {"enableBrakeThermals":true},
        {"brakeDiameter":0.26},
        {"brakeMass":6.5},
        {"brakeType":"vented-disc"},
        {"rotorMaterial":"steel"},
        {"brakeVentingCoef":1.0},
        //brake sounds
        {"squealCoefNatural": 0.0, "squealCoefLowSpeed": 0.0}
    ],
},
