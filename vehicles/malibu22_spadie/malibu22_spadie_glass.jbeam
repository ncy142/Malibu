{
"malibu22_spadie_windshield": {
    "information":{
        "authors":"BeamNG",
        "name":"Windshield",
        "value":340,
    },
    "slotType" : "malibu22_spadie_windshield",
    "slots": [
        ["type", "default", "description"],
        ["malibu22_spadie_sunstrip","", "Sun Strip"],
    ],
    "flexbodies": [
         ["mesh", "[group]:", "nonFlexMaterials"],
         //glass
         {"deformGroup":"windshield_break", "deformMaterialBase":"malibu22_spadie_glass", "deformMaterialDamaged":"malibu22_spadie_glass_windshield_dmg"},
         ["malibu22_spadie_windshield", ["malibu22_spadie_windshield"],[]{"deformSound":"event:>Destruction>Vehicle>Glass>impact_glass_windscreen_01", "deformVolume":0.7}],

         {"deformGroup":"windshield_break", "deformMaterialBase":"malibu22_spadie_glass_int", "deformMaterialDamaged":"malibu22_spadie_glass_int"},
         ["malibu22_spadie_windshield_int", ["malibu22_spadie_windshield"]],

         {"deformGroup":"windshield_break", "deformMaterialBase":"glass_invisible", "deformMaterialDamaged":"glass_mirror"},
         ["malibu22_spadie_windshield_dmg", ["malibu22_spadie_windshield"]],
         {"deformGroup":""},
         ["malibu22_spadie_wipers", ["malibu22_spadie_body", "malibu22_spadie_engine_bay"]],
    ],
    "sounds": {
        "$+cabinFilterCoef": 0.12
    }
    "nodes": [
         ["id", "posX", "posY", "posZ"],
         {"selfCollision":true},
         {"collision":true},
         {"frictionCoef":0.5},
         {"nodeMaterial":"|NM_GLASS"},
         {"nodeWeight":1.5},
         {"group":["gps","malibu22_spadie_windshield"]},
         ["wi1", 0, -0.62, 1.17],
         {"group":""},
         {"nodeMaterial":"|NM_METAL"},

         //windshield add weight
         {"nodeWeight":3.1},
         //a pillar
         ["p1r", -0.64803, -0.61044, 1.13000, {"group":["malibu22_spadie_body","malibu22_spadie_windshield"]}],
         ["p1l", 0.64803, -0.61044, 1.13000, {"group":["malibu22_spadie_body","malibu22_spadie_windshield"]}],
         //roof
         {"nodeWeight":2.8},
         ["rf1r", -0.59000, -0.11800, 1.32766, {"group":["malibu22_spadie_body","malibu22_spadie_windshield"]}],
         ["rf1", 0.00000, -0.15397, 1.36047, {"nodeWeight":1.0,"group":["malibu22_spadie_body","malibu22_spadie_windshield"]}],
         ["rf1l", 0.59000, -0.11800, 1.32766, {"group":["malibu22_spadie_body","malibu22_spadie_windshield"]}],
         //firewall
         {"nodeWeight":5.0},
         ["f6rr", -0.76000, -0.83495, 0.93000, {"group":["malibu22_spadie_engine_bay","malibu22_spadie_windshield","gps","malibu22_spadie_dash","malibu22_spadie_body"]}],
         ["f6r", -0.32000, -1.00542, 0.95000, {"nodeWeight":3.5, "group":["malibu22_spadie_engine_bay","malibu22_spadie_windshield","gps","malibu22_spadie_dash","malibu22_spadie_body","malibu22_spadie_strutbar"]}],
         ["f6l", 0.32000, -1.00542, 0.95000, {"nodeWeight":3.5, "group":["malibu22_spadie_engine_bay","malibu22_spadie_windshield","gps","malibu22_spadie_dash","malibu22_spadie_body","malibu22_spadie_strutbar"]}],
         ["f6ll", 0.76000, -0.83495, 0.93000, {"group":["malibu22_spadie_engine_bay","malibu22_spadie_windshield","gps","malibu22_spadie_dash","malibu22_spadie_body"]}],
    ],

    "beams": [
          ["id1:", "id2:"],
          {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},

          //weak windshield beams
          {"beamSpring":701000,"beamDamp":5},
          {"beamDeform":18500,"beamStrength":"FLT_MAX"},
          {"disableMeshBreaking":true,"disableTriangleBreaking":true},
          {"deformGroup":"windshield_break","deformationTriggerRatio":0.03},
          {"deformLimitExpansion":""},
          ["rf1","wi1"],
          ["rf1r","wi1"],
          ["rf1l","wi1"],
          ["wi1","f6r"],
          ["wi1","f6l"],
          ["wi1","p1r"],
          ["wi1","p1l"],
          ["wi1","f6rr"],
          ["wi1","f6ll"],

          ["wi1","p2rr"],
          ["wi1","p2ll"],
          {"beamDeform":18500,"beamStrength":1500},
          {"breakGroup":"windshield"},
          ["rf1","f6r"],
          ["rf1","f6l"],
          ["p1r","p1l"],
          ["rf1r","f6r"],
          ["rf1l","f6l"],

          {"breakGroup":""},
          {"deformGroup":""},
          {"disableMeshBreaking":false,"disableTriangleBreaking":false},
          {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
          {"deformLimitExpansion":1.1},
    ],
    "triangles": [
            ["id1:","id2:","id3:"],
            //windshield
            {"groundModel":"glass"},
            {"dragCoef":6.15},
            {"group":"malibu22_spadie_roof"},
            ["rf1","p1r","f6r"],
            ["rf1","f6l","p1l"],
            ["rf1","f6r","f6l"],
            {"dragCoef":0},
            {"group":""},
    ],
},
