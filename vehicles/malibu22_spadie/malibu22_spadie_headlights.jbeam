"malibu22_spadie_headlight_R": {
    "information":{
        "authors":"BeamNG",
        "name":"Right Headlight",
        "value":170,
    },
    "slotType" : "malibu22_spadie_headlight_R",
    "slots": [
        ["type", "default", "description"],
        ["malibu22_spadie_headlight_decal_R","","Right Headlight Decal"],
    ],
    "flexbodies": [
         ["mesh", "[group]:", "nonFlexMaterials"],
         ["malibu22_spadie_signal_frame_R", ["malibu22_spadie_headlight_R"]],
         ["malibu22_spadie_headlight_frame_R", ["malibu22_spadie_headlight_R"]],
         {"deformGroup":"headlightglass_R_break", "deformMaterialBase":"malibu22_spadie_glass", "deformMaterialDamaged":"malibu22_spadie_glass_dmg"},
         ["malibu22_spadie_headlight_glass_R", ["malibu22_spadie_headlight_R"],[]{"deformSound":"event:>Destruction>Vehicle>Glass>extglassbreaksound3", "deformVolume":0.5}],
         ["malibu22_spadie_signal_glass_R", ["malibu22_spadie_headlight_R"]],
         {"deformGroup":""},
         {"deformGroup":"headlightglass_R_break", "deformMaterialBase":"malibu22_spadie_lights", "deformMaterialDamaged":"malibu22_spadie_chrome"},
         ["malibu22_spadie_headlight_R", ["malibu22_spadie_headlight_R"]],
         ["malibu22_spadie_signal_R", ["malibu22_spadie_headlight_R"]],
         {"deformGroup":""},
    ],
    "props": [
        ["func"      , "mesh"              , "idRef:", "idX:", "idY:"            , "baseRotation"        , "rotation"                 , "translation"        , "min", "max", "offset", "multiplier"],
        {
            "lightInnerAngle":0,
            "lightOuterAngle":120,
            "lightColor":{"r":255, "g":255, "b":190, "a":255},
            "lightAttenuation":{"x":0, "y":1, "z":1},
            "lightCastShadows":true,
            "flareName":"vehicleHeadLightFlare",
            "cookieName":"art/special/BNG_light_cookie_headlight.dds"
            "texSize":512,
            "shadowSoftness":0.5,
        },
        //low beams
        ["lowbeam"    , "SPOTLIGHT"        , "he4r", "he3r", "he2r", {"x":220, "y":0, "z":30} , {"x":0, "y":0, "z":0}    , {"x":0, "y":0, "z":0}, 0, 0, 0, 1, {"baseTranslation":{"x":0.6, "y":0.35, "z":0.0},"lightRange":50,"lightBrightness":0.3,"lightOuterAngle":95,"flareScale":0,"deformGroup":"headlightglass_R_break"}],
        //high beams
        ["highbeam" ,         "SPOTLIGHT"        , "he4r", "he3r", "he2r", {"x":210, "y":0, "z":30} , {"x":0, "y":0, "z":0}    , {"x":0, "y":0, "z":0}, 0, 0, 0, 1, {"baseTranslation":{"x":0.6, "y":0.35, "z":0.0},"lightRange":80,"lightBrightness":0.7,"lightOuterAngle":80,"flareScale":0,"deformGroup":"headlightglass_R_break"}],
        //signal
        {
            "lightInnerAngle":0,
            "lightOuterAngle":120,
            "lightRange":8,
            "lightColor":{"r":255, "g":255, "b":0, "a":255},
            "lightAttenuation":{"x":0, "y":1, "z":1},
            "lightCastShadows":false,
            "flareName":"vehicleBrakeLightFlare",
        },
        ["lowhighbeam"    , "SPOTLIGHT"        , "he4r", "he3r", "he2r", {"x":200, "y":0, "z":0} , {"x":0, "y":0, "z":0}    , {"x":0, "y":0, "z":0}, 0, 0, 0, 1, {"baseTranslation":{"x":-0.2, "y":0.5, "z":0.03},"flareScale":0,"lightBrightness":0.01,"deformGroup":"headlightglass_R_break"}],
        ["signal_R"    , "SPOTLIGHT"        , "he4r", "he3r", "he2r", {"x":200, "y":0, "z":0} , {"x":0, "y":0, "z":0}    , {"x":0, "y":0, "z":0}, 0, 0, 0, 1, {"baseTranslation":{"x":-0.2, "y":0.5, "z":0.03},"flareScale":0,"lightBrightness":0.04,"deformGroup":"headlightglass_R_break"}],
     ],
    "nodes": [
         ["id", "posX", "posY", "posZ"],
         //--HEADLIGHT--
         //right
         {"selfCollision":true},
         {"collision":true},
         {"nodeMaterial":"|NM_PLASTIC"},
         {"frictionCoef":0.5},
         {"nodeWeight":0.4},
         {"group":"malibu22_spadie_headlight_R"},
         ["he1r", -0.57573, -2.05815, 0.69677],
         ["he3r", -0.57781, -2.10268, 0.65555],
         ["he2r", -0.80847, -1.78734, 0.74498],
         ["he4r", -0.81530, -1.83734, 0.68648],
         {"selfCollision":false},
         ["he5r", -0.66209, -1.85369, 0.69522],
         {"group":""},
    ],

    "beams": [
          ["id1:", "id2:"],
          {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
          //--HEADLIGHT--
          {"beamSpring":800600,"beamDamp":50},
          {"beamDeform":22815,"beamStrength":49725},
          //headlight main shape
          {"deformGroup":"headlightglass_R_break", "deformationTriggerRatio":0.005},
          {"deformLimitExpansion":1.1},
          //r
          ["he1r","he2r"],
          ["he3r","he4r"],
          ["he1r","he3r"],
          ["he2r","he4r"],

          ["he1r","he4r"],
          ["he2r","he3r"],

          ["he1r","he5r"],
          ["he2r","he5r"],
          ["he3r","he5r"],
          ["he4r","he5r"],
          //attach
          {"beamSpring":600600,"beamDamp":50},
          {"beamDeform":8995,"beamStrength":12050},
          {"deformLimitExpansion":""},
          //r
          {"breakGroup":"headlight_a_R"},
          ["he5r","f15rr"],
          ["he5r","f15r"],
          ["he2r","f15rr"],
          ["he4r","f15rr"],

          {"beamDeform":8995,"beamStrength":12050},
          {"breakGroup":"headlight_b_R"},
          ["he1r","f15r"],
          ["he1r","f15rr"],
          ["he3r","f15r"],
          ["he3r","f13rr"],

          {"breakGroup":""},
          {"deformGroup":""},

          //headlight support beams
          {"beamType":"|SUPPORT", "beamLongBound":4},
          {"beamSpring":600600,"beamDamp":50},
          {"beamDeform":11880,"beamStrength":297000},
          {"optional":true},
          //["he2r","h4"],
          //["he3r","h4r"],
          {"optional":false},

          {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
          {"deformLimitExpansion":1.1},

    ],
    "triangles": [
            ["id1:","id2:","id3:"],
            //right headlight
            {"groundModel":"plastic"},
            {"group":"malibu22_spadie_headlight_R"},
            {"dragCoef":6.15},
