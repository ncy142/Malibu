    "information":{
        "authors":"BeamNG",
        "name":"Race Front Sway Bar",
        "value":500,
    },
    "slotType" : "malibu22_spadie_swaybar_F",

    "flexbodies": [
        ["mesh", "[group]:", "nonFlexMaterials"],
        ["malibu22_spadie_swaybar_F_mount", ["malibu22_spadie_body"]],
        ["malibu22_spadie_swaybar_F", ["malibu22_spadie_lowerarm_F", "malibu22_spadie_subframe_F"]],
        ["malibu22_spadie_swaybar_droplink_FR", ["malibu22_spadie_lowerarm_F", "malibu22_spadie_subframe_F"]],
        ["malibu22_spadie_swaybar_droplink_FL", ["malibu22_spadie_lowerarm_F", "malibu22_spadie_subframe_F"]],
    ],
    "nodes": [
         ["id", "posX", "posY", "posZ"],
         //anti-roll
         {"nodeMaterial":"|NM_METAL"},
         {"frictionCoef":0.5},
         {"group":""},
         {"selfCollision":false},
         {"collision":true},
         {"nodeWeight":2},
         //front anti-roll
         ["arbfr", -0.7, -1.365, 0.30],
         ["arbfl", 0.7, -1.365, 0.30],
         {"group":""},
    ],
    "variables": [
        ["name", "type", "unit", "category", "default", "min", "max", "title", "description"],
        ["$arb_spring_F", "range", "N/m", "Suspension", 25000, 5000, 100000, "Anti-Roll Spring Rate", "Stiffness of the anti-roll bar, defined at the end links", {"stepDis":1000,"subCategory":"Front"}]
    ],
    "torsionbars": [
        ["id1:", "id2:", "id3:", "id4:"],
        //motion ratio 0.85 (difference between real and jbeam sway bar)
        //arm length 0.34
        {"spring":"$=$arb_spring_F*0.34*0.34*0.85*0.85", "damp":10, "deform":10000, "strength":9999999},
        ["arbfr", "fx2r", "fx2l", "arbfl"],
    ],
    "beams": [
          ["id1:", "id2:"],
          //--ANTI-ROLL--
          {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1, "beamShortBound":1},
          {"beamSpring":2501000,"beamDamp":100},
          {"beamDeform":15000,"beamStrength":300000},
          {"deformLimitExpansion":1.1},
          //end links
          ["arbfr","fh1r"],
          ["arbfl","fh1l"],
          //rigids
          ["arbfr","fx2r"],
          ["arbfl","fx2l"],
          {"deformLimitExpansion":""},
          ["arbfr","fx2l"],
          ["arbfl","fx2r"],
          {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
          {"deformLimitExpansion":1.1},
    ],
},
