"malibu22_spadie_dashboard": {
    "information":{
        "authors":"BeamNG",
        "name":"Dashboard",
        "value":500,
    },
    "slotType" : "malibu22_spadie_dashboard",
    "slots": [
        ["type", "default", "description"],
        ["malibu22_spadie_steer","malibu22_spadie_steer", "Steering Wheel"],
        ["malibu22_spadie_gauges","malibu22_spadie_gauges_imperial", "Gauges", {"coreSlot":true}],
        ["malibu22_spadie_shifter","malibu22_spadie_shifter_A", "Shifter", {"coreSlot":true}],
        ["malibu22_spadie_shiftlight","", "Shift Light"],
        ["malibu22_spadie_interrior_accessory","", "Dashboard Accessories"],
    ],
    "flexbodies": [
        ["mesh", "[group]:", "nonFlexMaterials"],
        ["malibu22_spadie_dashboard", ["malibu22_spadie_dash"]],
        ["malibu22_spadie_footrest", ["malibu22_spadie_body"]],
        ["malibu22_spadie_decals_gauges_stuff", ["malibu22_spadie_dash"]],
        ["malibu22_spadie_mirror_int", ["malibu22_spadie_body"]],
    ],
    "mirrors": [
        ["mesh", "idRef:", "id1:", "id2:"],
        ["malibu22_spadie_mirror_int","rf1","rf1r","rf2",{"refBaseTranslation":{"x":0.00,"y":-0.08,"z":-0.09},"baseRotationGlobal":{"x":6,"y":0,"z":19}}],
    ],
    "props": [
        ["func"      , "mesh"              , "idRef:", "idX:", "idY:"            , "baseRotation"        , "rotation"                 , "translation"        , "min", "max", "offset", "multiplier"],
        //pedals
        ["brake",        "malibu22_spadie_pedal_brake",    "f1l","f1r","f6l",        {"x":-2 "y":0, "z":180},   {"x":-20, "y":0, "z":0},   {"x":0.0, "y":0, "z":0}, 0, 1, 0, 1],
        ["throttle",     "malibu22_spadie_pedal_gas",      "f1l","f1r","f6l",        {"x":-2, "y":0, "z":180},   {"x":-14, "y":0, "z":0},   {"x":0.0, "y":0, "z":0}, 0, 1, 0, 1],
        //turn signal stalk
        ["turnsignal",   "malibu22_spadie_signalstalk",   "dshl","dsh","int_strw",        {"x":0, "y":0, "z":180}, {"x":0, "y":0, "z":-15},   {"x":0, "y":0, "z":0}, -1, 1, 0.0, 1],
        //wiper stalk
        ["wipers",       "malibu22_spadie_wiperstalk",   "dshl","dsh","int_strw",        {"x":-20, "y":-15, "z":160}, {"x":0, "y":0, "z":15},    {"x":0, "y":0, "z":0}, -1, 1, 0.0, 1],
        //parkingbrake
        ["parkingbrake", "malibu22_spadie_handbrake",  "f7r","f7l","f8r",        {"x":90, "y":0, "z":0} ,   {"x":-22, "y":0, "z":0},   {"x":0.0, "y":0, "z":0}, 0, 1, 0, 1],
    ],
    "controller": [
        ["fileName"],
        ["beamNavigator", {"screenMaterialName": "@malibu22_spadie_screen", "htmlFilePath": "local://local/vehicles/common/ETK_navi_screen.html", "name":"malibu22_spadie_navi"}],
    ],
    "camerasInternal":[
