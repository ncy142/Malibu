{
"malibu22_spadie": {
    "information":{
        "authors":"BeamNG",
        "name":"Ibishu Pessima",
    },
    "slotType" : "main",
    "slots": [
        ["type", "default", "description"],
        ["malibu22_spadie_body", "malibu22_spadie_body", "Body", {"coreSlot":true}],
        ["licenseplate_design_2_1","","License Plate Design"],
        ["malibu22_spadie_mod", "", "Additional Modification"],
    ],

    "scaledragCoef":0.88,

    "variables": [
        ["name", "type", "unit", "category", "default", "min", "max", "title", "description"],
        ["$brakestrength", "range", "", "Brakes", 1, 0.6, 1.0, "Brake Force Multiplier", "Scales the overall brake torque for this setup", {"minDis":60, "maxDis":100}],
        ["$ffbstrength", "range", "", "Chassis", 1, 0.5, 1.5, "Setup-Specific Force Feedback Multiplier", "Scales the force feedback strength for THIS SETUP ONLY", {"minDis":50, "maxDis":150}],
    ],
    "glowMap":{
            "malibu22_spadie_signal_L":{"simpleFunction":{"signal_L":0.49}, "off":"malibu22_spadie_chrome", "on":"malibu22_spadie_yellow_on", "on_intense":"malibu22_spadie_yellow_on"},
            "malibu22_spadie_signal_R":{"simpleFunction":{"signal_R":0.49}, "off":"malibu22_spadie_chrome", "on":"malibu22_spadie_yellow_on", "on_intense":"malibu22_spadie_yellow_on"},
            "malibu22_spadie_brakelight_L":{"simpleFunction":{"brakelight_signal_L":1.0}, "off":"malibu22_spadie_chrome", "on":"malibu22_spadie_lights_on", "on_intense":"malibu22_spadie_lights_on_intense"},
            "malibu22_spadie_brakelight_R":{"simpleFunction":{"brakelight_signal_R":1.0}, "off":"malibu22_spadie_chrome", "on":"malibu22_spadie_lights_on", "on_intense":"malibu22_spadie_lights_on_intense"},
            "malibu22_spadie_chmsl":{"simpleFunction":{"brake":100}, "off":"malibu22_spadie_taillight_frame", "on":"malibu22_spadie_lights_on", "on_intense":"malibu22_spadie_lights_on_intense"},
            "malibu22_spadie_lowbeam":{"simpleFunction":{"lowbeam":0.49,"highbeam":1}, "off":"malibu22_spadie_chrome", "on":"malibu22_spadie_lights_on", "on_intense":"malibu22_spadie_lights_on_intense"},
            "malibu22_spadie_taillights":{"simpleFunction":{"lowhighbeam":0.49}, "off":"malibu22_spadie_taillight_frame", "on":"malibu22_spadie_red_on", "on_intense":"malibu22_spadie_red_on"},
            "malibu22_spadie_highbeam":{"simpleFunction":{"highbeam":1}, "off":"malibu22_spadie_chrome", "on":"malibu22_spadie_lights_on", "on_intense":"malibu22_spadie_lights_on_intense"},
            "malibu22_spadie_reverselights":{"simpleFunction":{"reverse":0.49}, "off":"malibu22_spadie_chrome", "on":"malibu22_spadie_lights_on", "on_intense":"malibu22_spadie_lights_on_intense"},
            "malibu22_spadie_foglights":{"simpleFunction":{"fog":1}, "off":"malibu22_spadie_chrome", "on":"malibu22_spadie_lights_on", "on_intense":"malibu22_spadie_lights_on"},

            "malibu22_spadie_screen":{"simpleFunction":"running", "off":"screen_off", "on":"malibu22_spadie_screen"},
            "malibu22_spadie_red_needles":{"simpleFunction":"running", "off":"invis", "on":"malibu22_spadie_red_needles"},
            "malibu22_spadie_screens":{"simpleFunction":"running", "off":"malibu22_spadie_screens", "on":"malibu22_spadie_screens_infotament"},

            "malibu22_spadie_gauges_metric":{"simpleFunction":"lowhighbeam", "off":"malibu22_spadie_gauges_metric", "on":"malibu22_spadie_gauges_metric_on"},

            //gauge lights
            "signal_L":{"simpleFunction":"signal_L", "off":"invis", "on":"bastion_decals_gauges"},
            "signal_R":{"simpleFunction":"signal_R", "off":"invis", "on":"bastion_decals_gauges"},
            "esc":{"simpleFunction":{"esc":0.49,"tcs":0.49}, "off":"invis", "on":"bastion_decals_gauges"},
            "lowhighbeam":{"simpleFunction":"lowhighbeam", "off":"invis", "on":"bastion_decals_gauges"},
            "highbeam":{"simpleFunction":"highbeam", "off":"invis", "on":"bastion_decals_gauges"},
            "parkingbrake":{"simpleFunction":"parkingbrakelight", "off":"invis", "on":"bastion_decals_gauges"},
            "checkengine":{"simpleFunction":"checkengine", "off":"invis", "on":"bastion_decals_gauges"},
    },
},
}
