"malibu22_spadie_transmission_9A": {
    "information":{
        "authors":"BeamNG",
        "name":"9-Speed Automatic Transmission",
        "value":930,
    },
    "slotType" : "malibu22_spadie_transmission",
    "slots": [
        ["type", "default", "description"],
        ["malibu22_spadie_converter","malibu22_spadie_converter","Torque Converter", {"coreSlot":true}],
        ["malibu22_spadie_differential_F","malibu22_spadie_differential_F", "Front Differential"],
    ],
    "powertrain": [
        ["type", "name", "inputName", "inputIndex"],
        ["torqueConverter", "torqueConverter", "mainEngine", 1],
        ["automaticGearbox", "gearbox", "torqueConverter", 1],
    ],
    "gearbox": {
        "uiName":"Gearbox",
        "gearRatios":[-2.33, 0, 4.69, 3.51, 3.00, 2.43, 1.92, 1.45, 1.00, 0.75, 0.62],
        "parkLockTorque":2000,
        "oneWayViscousCoef":40,
        "shiftEfficiency":0.7,
        "gearChangeTime": 0.1,
        "friction": 1.03,
        "dynamicFriction": 0.0011,
        "torqueLossCoef": 0.017,
        "gearboxNode:":["ta1"],
    },
    "vehicleController": {
        "automaticModes":"PRNDSM",
        "calculateOptimalLoadShiftPoints": true,
        "transmissionGearChangeDelay":0.5,
        "aggressionSmoothingUp":1.15,
        "aggressionSmoothingDown":0.4,
        "gearboxDecisionSmoothingUp":2,
        "gearboxDecisionSmoothingDown":2,
        "lowShiftDownRPM":1200,
        "lowShiftUpRPM":2000,
        //"highShiftDownRPM":3300,
    },
    "flexbodies": [
        ["mesh", "[group]:", "nonFlexMaterials"],
        ["malibu22_spadie_transmission", ["malibu22_spadie_engine","malibu22_spadie_transmission"]],
    ],
    "nodes": [
         ["id", "posX", "posY", "posZ"],
         //--4 Speed Auto--
         {"selfCollision":false},
         {"collision":true},
         {"nodeMaterial":"|NM_METAL"},
         {"frictionCoef":0.5},
         {"group":"malibu22_spadie_transmission"},
         {"nodeWeight":12},
         ["tra1r",-0.31, -1.34, 0.365],
         ["tra1l", 0.31, -1.34, 0.365],
         {"group":""},
         ["ta1", 0, -1.34, 0.39],
         //transmission mount node
