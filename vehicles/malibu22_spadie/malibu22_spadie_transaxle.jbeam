"malibu22_spadie_transaxle_CVT": {
    "information":{
        "authors":"BeamNG",
        "name":"Continuously Variable Transaxle",
        "value":4000,
    },
    "slotType" : "malibu22_spadie_transmission",
    "slots2": [
        ["name",                    "allowTypes",                "denyTypes", "default",                    "description"],
        ["malibu22_spadie_transfer_case",  ["malibu22_spadie_transfer_case"],  [],          "malibu22_spadie_transfer_case_FWD", "Transfer Case"],
        ["malibu22_spadie_differential_F", ["malibu22_spadie_differential_F"], [],          "malibu22_spadie_differential_F",    "Front Differential"],
    ],
    "powertrain": [
        ["type", "name", "inputName", "inputIndex"],
        ["torqueConverter", "torqueConverter", "mainEngine", 1],
        ["cvtGearbox", "gearbox", "torqueConverter", 1],
    ],
    "torqueConverter": {
        "uiName":"Torque Converter",
        "converterDiameter": 0.242,
        "converterStiffness":6,
        "couplingAVRatio":0.92,
        "stallTorqueRatio":2.00,
        "additionalEngineInertia":0.14,
    },
    "gearbox": {
        "uiName":"Gearbox",
        "minGearRatio":0.570,
        "maxGearRatio":3.48,
        "friction": 0.92,
        "dynamicFriction": 0.00091,
        "torqueLossCoef": 0.019,
        "oneWayViscousCoef":30,
        "parkLockTorque":2000,
        "gearboxNode:":["tra1"],
    },
    "vehicleController": {
        "shiftLogicName":"cvtGearbox2"
        "automaticModes":"PRNDS",
        "aggressionSmoothingDown":0.5,
        "aggressionHoldOffThrottleDelay":2.25,
        "cvtGearRatioSmoothingIn": 6
        "cvtGearRatioSmoothingOut": 4
        "cvtTargetRPMMap":[
            [0,50],
            [0, 700, 1200],
            [0.33, 1800, 2000],
            [0.67, 2400, 2400],
            [1, 6077, 6077],
        ],
        "cvtSportGearRatios": [3.58, 2.37, 1.75, 1.32, 0.98, 0.73, 0.57], // Same as DCT, but with CVT limits
    },
    "flexbodies": [
         ["mesh", "[group]:", "nonFlexMaterials"],
         ["malibu22_spadie_transmission", ["malibu22_spadie_engine","malibu22_spadie_transaxle"]],
         //["malibu22_spadie_transmission_mountbraket", ["malibu22_spadie_body"]],
    ],
    "nodes": [
         ["id",   "posX", "posY", "posZ"],
         //--CVT transmission--
         {"frictionCoef":0.5},
         {"nodeMaterial":"|NM_METAL"},
         {"selfCollision":false},
         {"collision":true},
         {"group":"malibu22_spadie_transaxle"},
         {"nodeWeight":30},
         ["tra1", 0.000, -0.750,  0.335],
         {"group":""},
    ],
    "beams":[
        ["id1:", "id2:"],
        {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
        //--TRANSMISSION CONE--
        {"beamSpring":15001000,"beamDamp":500},
        {"beamDeform":175000,"beamStrength":"FLT_MAX"},
        ["tra1", "e2r"],
        ["tra1", "e4r"],
        ["tra1", "e2l"],
        ["tra1", "e4l"],
        ["tra1", "e1r"],
        ["tra1", "e3r"],
        ["tra1", "e1l"],
        ["tra1", "e3l"],
        {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
    ],
